# 🌐 Server
APP_PORT = 2

# 🗄️ Database
DB_URL =
NODE_ENV =
# DB_SYNC=true

# Connection pool (400-500 bir vaqtdagi foydalanuvchi uchun sozlangan;
# Postgres serveringizning max_connections qiymatidan pastroq bo'lsin —
# odatda: DB_POOL_MAX * app instance soni < Postgres max_connections - 10)
DB_POOL_MAX = 30
DB_POOL_MIN = 5
DB_POOL_IDLE_MS = 30000
DB_POOL_CONN_TIMEOUT_MS = 5000

# 🤖 Telegram Bot
TELEGRAM_BOT_DEMO_TOKEN = 
TELEGRAM_BOT_PROD_TOKEN = 
ADMIN_TG_ID = 
BUNYOD_TG_ID = 


JWT_ACCESS_SECRET = 
JWT_ACCESS_TIME = 
JWT_REFRESH_SECRET= 
JWT_REFRESH_TIME= 

# 📱 Mobil ilova versiyasi (src/modules/app-version/app-releases.ts bilan birga)
# LATEST — Play'da HAMMAGA chiqqan eng yangi versionCode («Yangi versiya bor» taklifi). 0 = taklif yo'q
# MIN    — bundan past versionCode majburan yangilanadi. 0 = hech kim. Faqat reliz to'liq chiqqach ko'tariladi
APP_ANDROID_LATEST_VERSION_CODE = 0
APP_ANDROID_MIN_VERSION_CODE = 0
APP_IOS_LATEST_VERSION_CODE = 0
APP_IOS_MIN_VERSION_CODE = 0

# 🌍 Veb panel manzili (vergul bilan bir nechta) — production'da chat socket CORS uchun
FRONTEND_URL = https://bunyod-english.uz

# 🔔 Push bildirishnomalar (Expo Push Service, 2026-11)
# Ixtiyoriy: expo.dev → Access tokens. Bo'sh bo'lsa ham push ishlaydi (Expo «enhanced security» yoqilmagan bo'lsa)
EXPO_ACCESS_TOKEN =

# 🎥 Zoom (Server-to-Server OAuth app, Marketplace → Develop → Build App)
# Kalitlar bo'lmasa — onlayn dars «qo'lda havola» rejimida ishlaydi (avto yozuv/davomat yo'q)
ZOOM_ACCOUNT_ID =
ZOOM_CLIENT_ID =
ZOOM_CLIENT_SECRET =
# Darslar shu Zoom foydalanuvchi nomidan yaratiladi (Pro litsenziyali akkaunt emaili)
ZOOM_HOST_EMAIL =
# Event Subscriptions → Secret Token. Webhook: https://api.bunyod-english.uz/api/v1/zoom/webhook
# Hodisalar: meeting.started, meeting.ended, meeting.participant_joined, meeting.participant_left, recording.completed
ZOOM_WEBHOOK_SECRET =

# 🗂️ Dars yozuvlari ombori — DigitalOcean Spaces (S3). Bo'sh bo'lsa server diskiga (uploads/recordings)
SPACES_KEY =
SPACES_SECRET =
SPACES_BUCKET =
SPACES_REGION = fra1
SPACES_ENDPOINT = https://fra1.digitaloceanspaces.com
