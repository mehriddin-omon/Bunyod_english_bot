# 🌐 Server
APP_PORT = 2

# 🗄️ Database
DB_URL =
NODE_ENV =
# DB_SYNC=true

# Connection pool (400-500 bir vaqtdagi foydalanuvchi uchun sozlangan;
# Postgres serveringizning max_connections qiymatidan pastroq bo'lsin —
# odatda: DB_POOL_MAX * app instance soni < Postgres max_connections - 10)
DB_POOL_MAX = 30
DB_POOL_MIN = 5
DB_POOL_IDLE_MS = 30000
DB_POOL_CONN_TIMEOUT_MS = 5000

# 🤖 Telegram Bot
TELEGRAM_BOT_DEMO_TOKEN = 
TELEGRAM_BOT_PROD_TOKEN = 
ADMIN_TG_ID = 
BUNYOD_TG_ID = 


JWT_ACCESS_SECRET = 
JWT_ACCESS_TIME = 
JWT_REFRESH_SECRET= 
JWT_REFRESH_TIME= 

# 📱 Mobil ilova versiyasi (src/modules/app-version/app-releases.ts bilan birga)
# LATEST — Play'da HAMMAGA chiqqan eng yangi versionCode («Yangi versiya bor» taklifi). 0 = taklif yo'q
# MIN    — bundan past versionCode majburan yangilanadi. 0 = hech kim. Faqat reliz to'liq chiqqach ko'tariladi
APP_ANDROID_LATEST_VERSION_CODE = 0
APP_ANDROID_MIN_VERSION_CODE = 0
APP_IOS_LATEST_VERSION_CODE = 0
APP_IOS_MIN_VERSION_CODE = 0
